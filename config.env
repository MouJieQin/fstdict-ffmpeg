# config.env
# 固定版本锁定
FFMPEG_VERSION="8.1.2"
LAME_VERSION="3.100"

# 本仓库地址，自行替换
REPO_OWNER="MouJieQin"
REPO_NAME="fstdict-ffmpeg"

# 源码归档release标签（你手动上传源码包对应的tag）
SOURCE_RELEASE_TAG="SOURCE_ARCHIVE_v1"

# 编译输出目录
BUILD_ROOT="./build_out"
DIST_ROOT="./dist"

# FFmpeg configure 参数（统一一处维护）
FFMPEG_CONFIG_FLAGS=(
--enable-small
--disable-programs
--enable-ffmpeg
--disable-doc
--disable-avdevice
--disable-hwaccels
--disable-network
--disable-muxers
--enable-muxer=mp3,mov,wav,ogg,mp4
--disable-demuxers
--enable-demuxer=speex,ogg,amr,mp3,wav,mov,aac,flac,opus,wma
--disable-decoders
--enable-decoder=speex,amrnb,amrwb,mp3,pcm_s16le,vorbis,aac,flac,wma
--disable-encoders
--enable-encoder=aac,libmp3lame
--disable-filters
--enable-filter=aresample
--disable-protocols
--enable-protocol=pipe,file
--enable-libmp3lame
# === 新增修复参数 ===
--pkg-config-flags="--static"
)